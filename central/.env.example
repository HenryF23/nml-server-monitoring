# Default container image versions.
PROMETHEUS_VERSION=v3.13.2
GRAFANA_VERSION=13.1.3
CADDY_VERSION=2-alpine

# Prometheus
PROMETHEUS_BIND_IP=127.0.0.1
PROMETHEUS_PORT=9090
PROMETHEUS_RETENTION=30d

# Authenticated endpoint used by Prometheus agents on monitored servers.
# Keep this on a private LAN/VPN or put TLS in front of it.
REMOTE_WRITE_BIND_IP=0.0.0.0
REMOTE_WRITE_PORT=9091
MONITORING_TOKEN=CHANGE_ME

# Grafana
GRAFANA_BIND_IP=0.0.0.0
GRAFANA_PORT=3000
GRAFANA_ADMIN_USER=admin

# setup-central.sh generates this automatically on first setup.
GRAFANA_ADMIN_PASSWORD=CHANGE_ME
