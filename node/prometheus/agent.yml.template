global:
  scrape_interval: 15s
  scrape_timeout: 10s
  external_labels:
    server: "${SERVER_NAME}"
    tailscale_ip: "${TAILSCALE_IP}"
    gpu: "__GPU_ENABLED__"

scrape_configs:
  - job_name: prometheus-agent
    static_configs:
      - targets:
          - 127.0.0.1:9095

  - job_name: node-exporter
    static_configs:
      - targets:
          - 127.0.0.1:9100

  - job_name: cadvisor
    static_configs:
      - targets:
          - 127.0.0.1:18080

  # GPU_SCRAPE_JOB

remote_write:
  - name: central
    url: "http://__CENTRAL_TAILSCALE_IP__:9090/api/v1/write"
