global:
  scrape_interval: 15s
  scrape_timeout: 10s
  external_labels:
    server: "${SERVER_NAME}"
    gpu: "__GPU_ENABLED__"

scrape_configs:
  - job_name: prometheus-agent
    static_configs:
      - targets:
          - localhost:9090

  - job_name: node-exporter
    static_configs:
      - targets:
          - node-exporter:9100

  - job_name: cadvisor
    static_configs:
      - targets:
          - cadvisor:8080

  # GPU_SCRAPE_JOB

remote_write:
  - name: central
    url: "__REMOTE_WRITE_URL__"
    authorization:
      type: Bearer
      credentials_file: /run/secrets/monitoring_token
