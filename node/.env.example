# Friendly name shown in Grafana. setup-node.sh defaults to `hostname -s`.
SERVER_NAME=

# Full authenticated ingestion endpoint on the central server.
REMOTE_WRITE_URL=http://monitoring-server:9091/api/v1/write

# Default container image versions.
NODE_EXPORTER_VERSION=v1.12.1
CADVISOR_VERSION=v0.60.5
PROMETHEUS_VERSION=v3.13.2
DCGM_EXPORTER_TAG=latest

# Local-only Prometheus agent status page.
PROMETHEUS_AGENT_PORT=9095
